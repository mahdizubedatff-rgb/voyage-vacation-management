{
  "info": {
    "name": "Voyage — Vacation Management API",
    "description": "All REST endpoints of the Voyage backend. Run \"Login as admin\" and \"Login as user\" first: their test scripts store the JWTs in collection variables. Set baseUrl to http://localhost:8080/api (Docker) or http://localhost:4000/api (local dev).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080/api" },
    { "key": "adminEmail", "value": "admin@voyage.dev" },
    { "key": "adminPassword", "value": "Admin1234" },
    { "key": "userEmail", "value": "user@voyage.dev" },
    { "key": "userPassword", "value": "User1234" },
    { "key": "adminToken", "value": "" },
    { "key": "userToken", "value": "" },
    { "key": "vacationId", "value": "" }
  ],
  "item": [
    {
      "name": "Health",
      "request": { "method": "GET", "url": "{{baseUrl}}/health" }
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "pm.test('role is USER', () => pm.expect(pm.response.json().data.user.role).to.eql('USER'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Postman\",\n  \"lastName\": \"Tester\",\n  \"email\": \"postman{{$timestamp}}@voyage.dev\",\n  \"password\": \"pass1234\"\n}"
            }
          }
        },
        {
          "name": "Register — duplicate email (409)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Maya\",\n  \"lastName\": \"Cohen\",\n  \"email\": \"{{userEmail}}\",\n  \"password\": \"pass1234\"\n}"
            }
          }
        },
        {
          "name": "Login as admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('adminToken', pm.response.json().data.token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/login",
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}" }
          }
        },
        {
          "name": "Login as user",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('userToken', pm.response.json().data.token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/login",
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{userEmail}}\",\n  \"password\": \"{{userPassword}}\"\n}" }
          }
        },
        {
          "name": "Login — invalid credentials (401)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/login",
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{userEmail}}\",\n  \"password\": \"wrong-password\"\n}" }
          }
        },
        {
          "name": "Current user",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{userToken}}" }],
            "url": "{{baseUrl}}/auth/me"
          }
        }
      ]
    },
    {
      "name": "Vacations",
      "item": [
        {
          "name": "List vacations (all, page 1)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const data = pm.response.json().data;",
                  "pm.test('max 9 per page', () => pm.expect(data.items.length).to.be.at.most(9));",
                  "if (data.items[0]) pm.collectionVariables.set('vacationId', data.items[0].id);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{userToken}}" }],
            "url": { "raw": "{{baseUrl}}/vacations?filter=all&page=1", "host": ["{{baseUrl}}"], "path": ["vacations"], "query": [{ "key": "filter", "value": "all" }, { "key": "page", "value": "1" }] }
          }
        },
        {
          "name": "List — my liked vacations",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{userToken}}" }],
            "url": { "raw": "{{baseUrl}}/vacations?filter=liked", "host": ["{{baseUrl}}"], "path": ["vacations"], "query": [{ "key": "filter", "value": "liked" }] }
          }
        },
        {
          "name": "List — upcoming (not started)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{userToken}}" }],
            "url": { "raw": "{{baseUrl}}/vacations?filter=upcoming", "host": ["{{baseUrl}}"], "path": ["vacations"], "query": [{ "key": "filter", "value": "upcoming" }] }
          }
        },
        {
          "name": "List — active now",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{userToken}}" }],
            "url": { "raw": "{{baseUrl}}/vacations?filter=active", "host": ["{{baseUrl}}"], "path": ["vacations"], "query": [{ "key": "filter", "value": "active" }] }
          }
        },
        {
          "name": "Get vacation by id",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{userToken}}" }],
            "url": "{{baseUrl}}/vacations/{{vacationId}}"
          }
        },
        {
          "name": "Create vacation (admin, multipart)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('vacationId', pm.response.json().data.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": "{{baseUrl}}/vacations",
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "destination", "value": "Lisbon, Portugal", "type": "text" },
                { "key": "description", "value": "Pastel hills, yellow trams and golden evenings over the Tagus.", "type": "text" },
                { "key": "startDate", "value": "2027-06-01", "type": "text" },
                { "key": "endDate", "value": "2027-06-07", "type": "text" },
                { "key": "price", "value": "1890", "type": "text" },
                { "key": "image", "type": "file", "src": "", "description": "Select a JPEG/PNG/WebP image (max 5 MB), e.g. Backend/seed-images/paris.jpg" }
              ]
            }
          }
        },
        {
          "name": "Create vacation — invalid price (400)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": "{{baseUrl}}/vacations",
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "destination", "value": "Too Expensive", "type": "text" },
                { "key": "description", "value": "Should fail", "type": "text" },
                { "key": "startDate", "value": "2027-06-01", "type": "text" },
                { "key": "endDate", "value": "2027-06-07", "type": "text" },
                { "key": "price", "value": "10001", "type": "text" }
              ]
            }
          }
        },
        {
          "name": "Update vacation (admin, image optional)",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": "{{baseUrl}}/vacations/{{vacationId}}",
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "destination", "value": "Lisbon & Sintra, Portugal", "type": "text" },
                { "key": "description", "value": "Now with a day trip to the palaces of Sintra.", "type": "text" },
                { "key": "startDate", "value": "2027-06-01", "type": "text" },
                { "key": "endDate", "value": "2027-06-08", "type": "text" },
                { "key": "price", "value": "2090", "type": "text" },
                { "key": "image", "type": "file", "src": "", "disabled": true, "description": "Enable to replace the image" }
              ]
            }
          }
        },
        {
          "name": "Create vacation as user (403)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{userToken}}" }],
            "url": "{{baseUrl}}/vacations"
          }
        },
        {
          "name": "Delete vacation (admin)",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": "{{baseUrl}}/vacations/{{vacationId}}"
          }
        }
      ]
    },
    {
      "name": "Likes",
      "item": [
        {
          "name": "Like vacation (user)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{userToken}}" }],
            "url": "{{baseUrl}}/vacations/{{vacationId}}/likes"
          }
        },
        {
          "name": "Like again — duplicate (409)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{userToken}}" }],
            "url": "{{baseUrl}}/vacations/{{vacationId}}/likes"
          }
        },
        {
          "name": "Unlike vacation (user)",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{userToken}}" }],
            "url": "{{baseUrl}}/vacations/{{vacationId}}/likes"
          }
        }
      ]
    },
    {
      "name": "Reports (admin)",
      "item": [
        {
          "name": "Likes per vacation",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": "{{baseUrl}}/reports/likes"
          }
        },
        {
          "name": "Likes CSV export",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": "{{baseUrl}}/reports/likes/csv"
          }
        }
      ]
    },
    {
      "name": "AI & MCP (user)",
      "item": [
        {
          "name": "AI recommendation",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{userToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/ai/recommendations",
            "body": { "mode": "raw", "raw": "{\n  \"destination\": \"Kyoto, Japan\"\n}" }
          }
        },
        {
          "name": "Ask a question (MCP)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{userToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/mcp/ask",
            "body": { "mode": "raw", "raw": "{\n  \"question\": \"Which vacations are in Europe?\"\n}" }
          }
        }
      ]
    }
  ]
}

{
  "name": "voyage-backend",
  "version": "1.0.0",
  "description": "Voyage vacation management REST API and MCP server",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:mcp": "tsx watch src/mcp/httpServer.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "start:mcp": "node dist/mcp/httpServer.js",
    "mcp:stdio": "tsx src/mcp/stdio.ts",
    "seed": "tsx src/seed/seed.ts",
    "seed:prod": "node dist/seed/seed.js",
    "db:export": "tsx src/seed/exportDatabase.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "author": "Ameer Zubedat",
  "license": "UNLICENSED",
  "type": "commonjs",
  "dependencies": {
    "@google/genai": "^2.32.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.11.4",
    "morgan": "^1.12.1",
    "multer": "^2.5.0",
    "zod": "^3.25.76"
  },
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.6",
    "@types/supertest": "^7.2.1",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "mongodb-memory-server": "^11.3.0",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  }
}

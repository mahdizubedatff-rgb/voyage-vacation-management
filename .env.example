# Copy to .env (Docker Compose) and/or Backend/.env (local development), then adjust.
# Never commit real .env files.

# --- Security (required) ---
# Use a long random string, e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`
JWT_SECRET=replace-with-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=8h

# --- Local development only (Docker Compose sets these itself) ---
PORT=4000
MONGODB_URI=mongodb://localhost:27017/voyage
CORS_ORIGIN=http://localhost:5173,http://localhost:8080
MCP_SERVER_URL=http://localhost:4001/mcp
MCP_PORT=4001
MAX_UPLOAD_MB=5

# --- AI provider ---
# Leave ANTHROPIC_API_KEY empty to run without AI: recommendations return a clear 503 and
# MCP questions use the rule-based tool router (still real MCP calls).
AI_PROVIDER=anthropic
AI_MODEL=claude-opus-5-5
ANTHROPIC_API_KEY=

# --- Seed accounts (development only) ---
SEED_ADMIN_PASSWORD=Admin1234
SEED_USER_PASSWORD=User1234
